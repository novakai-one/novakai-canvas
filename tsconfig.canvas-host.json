{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.canvas-host.tsbuildinfo"
  },
  "include": [
    "src/App.tsx",
    "src/main.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/presentation/**/*.ts",
    "src/presentation/**/*.tsx"
  ],
  "exclude": [
    "src/presentation/prototype/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
