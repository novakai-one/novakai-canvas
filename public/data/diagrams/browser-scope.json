{
  "schemaVersion": 3,
  "id": "browser-scope",
  "name": "Agent Browser Sessions",
  "status": "active",
  "revision": 2439,
  "nodes": {
    "browser-scope": {
      "id": "browser-scope",
      "label": "Agent Browser Sessions",
      "description": "Isolated per-agent browser + live off-screen mirror",
      "interfaceIds": [],
      "typeIds": [],
      "kind": "group"
    },
    "bs-cli": {
      "id": "bs-cli",
      "label": "browse CLI",
      "description": "Agent-facing: browse --session <id> goto|click|shot",
      "interfaceIds": [],
      "typeIds": [],
      "kind": "module"
    },
    "bs-mirror": {
      "id": "bs-mirror",
      "label": "Mirror viewer",
      "description": "Off-screen screencast grid + copyable page URL",
      "parentId": "browser-scope",
      "interfaceIds": [],
      "typeIds": [],
      "kind": "module"
    },
    "bs-session": {
      "id": "bs-session",
      "label": "Session",
      "description": "Agent ↔ instance binding and lifecycle",
      "interfaceIds": [],
      "typeIds": [
        "bs-t-session",
        "bs-t-handle"
      ],
      "kind": "object"
    },
    "bs-broker": {
      "id": "bs-broker",
      "label": "Session broker",
      "description": "acquire / release / lookup; owns pool state",
      "parentId": "browser-scope",
      "interfaceIds": [
        "bs-acquire",
        "bs-release"
      ],
      "typeIds": [],
      "kind": "module"
    },
    "bs-policy": {
      "id": "bs-policy",
      "label": "Allocation policy",
      "description": "Pure: choose free instance, grow or evict",
      "parentId": "browser-scope",
      "interfaceIds": [],
      "typeIds": [],
      "kind": "object"
    },
    "bs-lease": {
      "id": "bs-lease",
      "label": "Lease",
      "description": "TTL claim; reclaims a dead agent's instance",
      "parentId": "browser-scope",
      "interfaceIds": [],
      "typeIds": [
        "bs-t-lease"
      ],
      "kind": "object"
    },
    "bs-pool": {
      "id": "bs-pool",
      "label": "Chrome pool",
      "description": "Adapter: launches headless Chrome, own user-data-dir + port",
      "interfaceIds": [
        "bs-launch"
      ],
      "typeIds": [
        "bs-t-instance"
      ],
      "kind": "module"
    },
    "bs-control": {
      "id": "bs-control",
      "label": "CDP control",
      "description": "Adapter: Playwright over CDP, target-scoped, never bringToFront",
      "parentId": "browser-scope",
      "interfaceIds": [
        "bs-act"
      ],
      "typeIds": [
        "bs-t-command"
      ],
      "kind": "module"
    },
    "bs-screencast": {
      "id": "bs-screencast",
      "label": "CDP screencast",
      "description": "Adapter: Page.startScreencast → JPEG frames",
      "parentId": "browser-scope",
      "interfaceIds": [
        "bs-frames"
      ],
      "typeIds": [
        "bs-t-frame"
      ],
      "kind": "module"
    },
    "bs-chrome": {
      "id": "bs-chrome",
      "label": "Chrome instances",
      "description": "N isolated processes, off-screen",
      "parentId": "browser-scope",
      "interfaceIds": [],
      "typeIds": [
        "bs-t-instance"
      ],
      "kind": "runtime"
    },
    "icon-grid-5c42029f": {
      "id": "icon-grid-5c42029f",
      "label": "New icon grid",
      "interfaceIds": [],
      "typeIds": [],
      "kind": "icon-grid"
    }
  },
  "wires": {
    "bs-w-cli-broker": {
      "id": "bs-w-cli-broker",
      "kind": "executes",
      "label": "acquire / release",
      "source": {
        "nodeId": "bs-cli"
      },
      "target": {
        "nodeId": "bs-broker"
      }
    },
    "bs-w-cli-control": {
      "id": "bs-w-cli-control",
      "kind": "executes",
      "label": "acts via",
      "source": {
        "nodeId": "bs-cli"
      },
      "target": {
        "nodeId": "bs-control"
      }
    },
    "bs-w-mirror-broker": {
      "id": "bs-w-mirror-broker",
      "kind": "queries",
      "label": "lists sessions",
      "source": {
        "nodeId": "bs-mirror"
      },
      "target": {
        "nodeId": "bs-broker"
      }
    },
    "bs-w-mirror-screencast": {
      "id": "bs-w-mirror-screencast",
      "kind": "queries",
      "label": "streams",
      "source": {
        "nodeId": "bs-mirror"
      },
      "target": {
        "nodeId": "bs-screencast"
      }
    },
    "bs-w-broker-session": {
      "id": "bs-w-broker-session",
      "kind": "owns",
      "label": "tracks",
      "source": {
        "nodeId": "bs-broker"
      },
      "target": {
        "nodeId": "bs-session"
      }
    },
    "bs-w-broker-lease": {
      "id": "bs-w-broker-lease",
      "kind": "owns",
      "label": "grants",
      "source": {
        "nodeId": "bs-broker"
      },
      "target": {
        "nodeId": "bs-lease"
      }
    },
    "bs-w-broker-policy": {
      "id": "bs-w-broker-policy",
      "kind": "queries",
      "label": "decides via",
      "source": {
        "nodeId": "bs-broker"
      },
      "target": {
        "nodeId": "bs-policy"
      }
    },
    "bs-w-broker-pool": {
      "id": "bs-w-broker-pool",
      "kind": "executes",
      "label": "launch / dispose",
      "source": {
        "nodeId": "bs-broker"
      },
      "target": {
        "nodeId": "bs-pool"
      }
    },
    "bs-w-control-chrome": {
      "id": "bs-w-control-chrome",
      "kind": "executes",
      "label": "drives target",
      "source": {
        "nodeId": "bs-control"
      },
      "target": {
        "nodeId": "bs-chrome"
      }
    },
    "bs-w-screencast-chrome": {
      "id": "bs-w-screencast-chrome",
      "kind": "queries",
      "label": "captures",
      "source": {
        "nodeId": "bs-screencast"
      },
      "target": {
        "nodeId": "bs-chrome"
      }
    },
    "bs-w-pool-chrome": {
      "id": "bs-w-pool-chrome",
      "kind": "owns",
      "label": "spawns",
      "source": {
        "nodeId": "bs-pool"
      },
      "target": {
        "nodeId": "bs-chrome"
      }
    },
    "bs-w-session-chrome": {
      "id": "bs-w-session-chrome",
      "kind": "references",
      "label": "endpoint",
      "source": {
        "nodeId": "bs-session"
      },
      "target": {
        "nodeId": "bs-chrome"
      }
    }
  },
  "interfaces": {
    "bs-acquire": {
      "id": "bs-acquire",
      "ownerId": "bs-broker",
      "name": "acquire",
      "accepts": [
        "AgentId"
      ],
      "returns": [
        "SessionHandle"
      ]
    },
    "bs-release": {
      "id": "bs-release",
      "ownerId": "bs-broker",
      "name": "release",
      "accepts": [
        "SessionId"
      ],
      "returns": [
        "void"
      ]
    },
    "bs-launch": {
      "id": "bs-launch",
      "ownerId": "bs-pool",
      "name": "launch",
      "accepts": [
        "LaunchSpec"
      ],
      "returns": [
        "BrowserInstance"
      ]
    },
    "bs-act": {
      "id": "bs-act",
      "ownerId": "bs-control",
      "name": "act",
      "accepts": [
        "SessionId",
        "BrowserCommand"
      ],
      "returns": [
        "ActionResult"
      ]
    },
    "bs-frames": {
      "id": "bs-frames",
      "ownerId": "bs-screencast",
      "name": "subscribe",
      "accepts": [
        "SessionId"
      ],
      "returns": [
        "Frame[]"
      ]
    }
  },
  "types": {
    "bs-t-session": {
      "id": "bs-t-session",
      "name": "Session",
      "fields": [
        "id",
        "agentId",
        "instancePort",
        "status"
      ]
    },
    "bs-t-handle": {
      "id": "bs-t-handle",
      "name": "SessionHandle",
      "fields": [
        "sessionId",
        "cdpEndpoint",
        "mirrorUrl",
        "pageUrl"
      ]
    },
    "bs-t-lease": {
      "id": "bs-t-lease",
      "name": "Lease",
      "fields": [
        "sessionId",
        "agentId",
        "expiresAt"
      ]
    },
    "bs-t-instance": {
      "id": "bs-t-instance",
      "name": "BrowserInstance",
      "fields": [
        "pid",
        "port",
        "userDataDir"
      ]
    },
    "bs-t-command": {
      "id": "bs-t-command",
      "name": "BrowserCommand",
      "fields": [
        "kind",
        "selector",
        "text"
      ]
    },
    "bs-t-frame": {
      "id": "bs-t-frame",
      "name": "Frame",
      "fields": [
        "sessionId",
        "seq",
        "jpeg"
      ]
    }
  },
