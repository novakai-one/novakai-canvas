  "flows": {
    "flow-every-second": {
      "id": "flow-every-second",
      "name": "1 Every second, known files",
      "steps": [
        {
          "ref": "ingestion-offset-fix--wire-1",
          "ordinal": 1,
          "label": "tick: watch.ts wakes ingest.ts"
        },
        {
          "ref": "ingestion-offset-fix--wire-2",
          "ordinal": 2,
          "label": "ingest.ts loads the offset table"
        },
        {
          "ref": "ingestion-offset-fix--wire-3",
          "ordinal": 3,
          "label": "ingest.ts hands known paths to source.ts"
        },
        {
          "ref": "ingestion-offset-fix--wire-4",
          "ordinal": 4,
          "label": "source.ts stats each file — unchanged = skip"
        },
        {
          "ref": "ingestion-offset-fix--wire-8",
          "ordinal": 5,
          "label": "source.ts reads only the new bytes"
        },
        {
          "ref": "ingestion-offset-fix--wire-12",
          "ordinal": 6,
          "label": "ingest.ts commits lines + moves the offset"
        }
      ]
    },
    "flow-new-file": {
      "id": "flow-new-file",
      "name": "2 New file appears",
      "steps": [
        {
          "ref": "ingestion-offset-fix--wire-9",
          "ordinal": 1,
          "label": "roots-watcher sees the roots change"
        },
        {
          "ref": "ingestion-offset-fix--wire-10",
          "ordinal": 2,
          "label": "roots-watcher flags watch.ts dirty"
        },
        {
          "ref": "ingestion-offset-fix--wire-1",
          "ordinal": 3,
          "label": "next tick runs with dirty set"
        },
        {
          "ref": "ingestion-offset-fix--wire-11",
          "ordinal": 4,
          "label": "ingest.ts asks source.ts for ONE full walk"
        },
        {
          "ref": "ingestion-offset-fix--wire-12",
          "ordinal": 5,
          "label": "new file gets a checkpoint + first ingest"
        }
      ]
    },
    "flow-offset-fails": {
      "id": "flow-offset-fails",
      "name": "3 Offset fails",
      "steps": [
        {
          "ref": "ingestion-offset-fix--wire-4",
          "ordinal": 1,
          "label": "stat mismatch — file shrank or inode changed"
        },
        {
          "ref": "ingestion-offset-fix--wire-8",
          "ordinal": 2,
          "label": "source.ts re-reads that ONE file from zero"
        },
        {
          "ref": "ingestion-offset-fix--wire-12",
          "ordinal": 3,
          "label": "ingest.ts commits under a new epoch"
        }
      ]
    }
  },
