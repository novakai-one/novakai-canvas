    },
    "mission-room-system-wiring--note-2-write-rule-mission-commi": {
      "id": "mission-room-system-wiring--note-2-write-rule-mission-commi",
      "kind": "comment",
      "label": "WRITE RULE: mission commissioning records canonical linkage explicitly. Reads never infer it from titles, agent names or the active session.",
      "interfaceIds": [],
      "typeIds": [],
      "parentId": "mission-room-system-wiring"
    },
    "mission-room-system-wiring--note-3-identity-rule-mission-th": {
      "id": "mission-room-system-wiring--note-3-identity-rule-mission-th",
      "kind": "comment",
      "label": "IDENTITY RULE: Mission Thread, provider execution Thread and zero-or-many Rooms stay explicitly named until their underlying models are unified.",
      "interfaceIds": [],
      "typeIds": [],
      "parentId": "mission-room-system-wiring"
    },
