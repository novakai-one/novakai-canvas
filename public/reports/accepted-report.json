    "decisions": [
      {
        "id": "receipt:0ca6b5ea24d35a74810b33b99638208ae1c55ff005d5bea8e02dccd6fb586370",
        "sourceDigest": "sha256:21d93e8f6917a9fad62de56a35310bbfebb2899cf374907afe1c48a7d68f7461",
        "type": "decision",
        "title": "Problem resolved — Template field checks could be bypassed through JavaScript's prototype chain, letting a declared field silently vanish at render time.",
        "summary": "Problem — Template field checks could be bypassed through JavaScript's prototype chain, letting a declared field silently vanish at render time. Resolution — The S4 auditor reproduced it. Field matching now uses own-key checks and prototype-related names are rejected from the allowlist, with regression tests.",
        "evidence": [
          {
            "kind": "test",
            "label": "Prototype-chain regression tests"
          }
        ]
      },
      {
        "id": "receipt:5049c714c06ff2d8c2ab094650dc881f1840060b5b161df1c32b55553afaad06",
        "sourceDigest": "sha256:21d93e8f6917a9fad62de56a35310bbfebb2899cf374907afe1c48a7d68f7461",
        "type": "decision",
        "title": "One runtime dependency",
        "summary": "The whole package runs on a single dependency (the ws WebSocket library). Everything else is Node built-ins, which keeps the supply chain small and the harness dependency-free.",
        "evidence": []
      },
      {
        "id": "receipt:99cdb04c8e9e864089ba15813dbff109d66f626bbb429792ffcfde8ed6583f74",
        "sourceDigest": "sha256:21d93e8f6917a9fad62de56a35310bbfebb2899cf374907afe1c48a7d68f7461",
        "type": "decision",
        "title": "Blocked room messages fail at commit time, not afterwards",
        "summary": "The S2 auditor proved a blocked recipient could still receive a message in the gap between commit and the post-commit effect pass. The fix makes the block terminal inside the same atomic commit, so no later code path can ever see the blocked delivery as sendable.",
        "evidence": [
          {
            "kind": "test",
            "label": "Terminal-at-commit regression tests"
          }
        ]
      },
      {
        "id": "receipt:9bf53dea635e22b6cd5f574dd8c41ff00dc3bc2245408237e2514ae2cd830f05",
        "sourceDigest": "sha256:21d93e8f6917a9fad62de56a35310bbfebb2899cf374907afe1c48a7d68f7461",
        "type": "decision",
        "title": "Problem resolved — A ContactPolicy-blocked room recipient could still be delivered the message through two ordinary timing interleavings.",
        "summary": "Problem — A ContactPolicy-blocked room recipient could still be delivered the message through two ordinary timing interleavings. Resolution — The S2 auditor reproduced both paths. The block is now applied terminally inside the atomic commit, which removes the vulnerable window entirely.",
        "evidence": [
          {
            "kind": "test",
            "label": "Blocked-recipient interleaving tests"
          }
        ]
      },
      {
        "id": "receipt:a8547715aefde58a67779f31b58600705afa2792b62546c6f1acf4157d65ecd8",
        "sourceDigest": "sha256:21d93e8f6917a9fad62de56a35310bbfebb2899cf374907afe1c48a7d68f7461",
        "type": "decision",
        "title": "The contract JSON stayed frozen after Step 2",
        "summary": "Everything the build later needed was added as numbered, dated errata in the store-seam document instead of editing the frozen contract. The drift guard and codegen kept one source of truth the whole way through.",
        "evidence": []
      },
      {
        "id": "receipt:f21ad371dcef87bf92f053aeb025fc2e11546a541ee20f0dfcee5e1372833d18",
        "sourceDigest": "sha256:21d93e8f6917a9fad62de56a35310bbfebb2899cf374907afe1c48a7d68f7461",
        "type": "decision",
        "title": "Problem resolved — The JSONL store adapter was not atomic under concurrency: two retries of the same message could both be accepted.",
        "summary": "Problem — The JSONL store adapter was not atomic under concurrency: two retries of the same message could both be accepted. Resolution — The S1 auditor reproduced it with real concurrent calls. Every store mutation now goes through a per-store queue, and the regression tests were shown to fail before the fix and pass after.",
        "evidence": [
          {
            "kind": "test",
            "label": "Concurrent atomicity tests"
          }
        ]
      }
    ],
